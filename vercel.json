{
  "version": 2,
  "builds": [
    {
      "src": "platform.html",
      "use": "@vercel/static"
    },
    {
      "src": "platform.css",
      "use": "@vercel/static"
    },
    {
      "src": "platform.js",
      "use": "@vercel/static"
    },
    {
      "src": "finance.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "X-Frame-Options": "DENY",
        "Cache-Control": "no-store",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' https://cdn.plaid.com https://plugin.argyle.com; style-src 'self' 'unsafe-inline'; connect-src 'self' https://*.plaid.com https://*.argyle.com; frame-src https://*.plaid.com https://*.argyle.com; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js?route=$1"
    },
    {
      "src": "/",
      "dest": "/platform.html"
    },
    {
      "src": "/index\\.html",
      "dest": "/platform.html"
    },
    {
      "src": "/platform\\.html",
      "dest": "/platform.html"
    },
    {
      "src": "/platform\\.css",
      "dest": "/platform.css"
    },
    {
      "src": "/platform\\.js",
      "dest": "/platform.js"
    },
    {
      "src": "/finance\\.js",
      "dest": "/finance.js"
    },
    {
      "src": "/.*",
      "status": 404
    }
  ]
}

